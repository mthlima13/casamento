# Porta do servidor
PORT=3000

# Conexão MongoDB
MONGODB_URI=mongodb://localhost:27017/convite_casamento

# Chave usada para acessar a rota GET /api/guests/list (painel /admin).
# Use uma senha forte. Deve ser a mesma digitada no painel.
ADMIN_KEY=troque-por-uma-senha-forte

# URL do frontend em produção, separada por vírgulas se houver mais de uma.
# Deixe vazio para liberar todas as origens (apenas em desenvolvimento).
CORS_ORIGIN=

NODE_ENV=development
